// netlify/functions/download.js
// Validates a purchase token and redirects to the current PDF URL.
// The PDF URL lives in Airtable so Katie can update it without touching code.
// Each token allows up to MAX_DOWNLOADS uses (covers multiple devices).

const fetch = require('node-fetch');

const AIRTABLE_BASE = process.env.AIRTABLE_BASE_ID;
const AIRTABLE_KEY  = process.env.AIRTABLE_API_KEY;
const AIRTABLE_URL  = `https://api.airtable.com/v0/${AIRTABLE_BASE}`;
const MAX_DOWNLOADS = 10; // generous limit; reset any time via Airtable

async function airtable(path, method = 'GET', body = null) {
  const opts = {
    method,
    headers: {
      'Authorization': `Bearer ${AIRTABLE_KEY}`,
      'Content-Type': 'application/json'
    }
  };
  if (body) opts.body = JSON.stringify(body);
  const res = await fetch(`${AIRTABLE_URL}${path}`, opts);
  return res.json();
}

function errorPage(title, message) {
  return `<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>${title} — PinkpillRx</title>
  <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@600;700;800&display=swap" rel="stylesheet">
  <style>
    body{margin:0;font-family:'Nunito',sans-serif;background:linear-gradient(135deg,#EBF7F6,#FDEEF0);min-height:100vh;display:flex;align-items:center;justify-content:center;padding:24px}
    .card{background:#fff;border-radius:20px;padding:48px 40px;max-width:480px;width:100%;text-align:center;box-shadow:0 8px 40px rgba(0,0,0,0.09)}
    h1{font-size:1.75rem;color:#1A1A1A;margin-bottom:12px}
    p{color:#6B6568;line-height:1.7;margin-bottom:24px}
    a{color:#D4616A;font-weight:700;text-decoration:none}
    .stripe{height:4px;background:linear-gradient(to right,#6BBFB8 50%,#E8939A 50%);border-radius:2px;margin:0 auto 28px;width:56px}
  </style>
</head>
<body>
  <div class="card">
    <div class="stripe"></div>
    <h1>${title}</h1>
    <p>${message}</p>
    <a href="/">Back to Shop</a>
  </div>
</body>
</html>`;
}

exports.handler = async (event) => {
  const token = event.queryStringParameters?.token;

  if (!token) {
    return {
      statusCode: 400,
      headers: { 'Content-Type': 'text/html' },
      body: errorPage('Invalid link.', 'This download link is missing a token. If you believe this is an error, email <a href="mailto:pinkpillrx@gmail.com">pinkpillrx@gmail.com</a>.')
    };
  }

  try {
    // Find the order matching this token
    const encoded = encodeURIComponent(`{Download Token}="${token}"`);
    const orderData = await airtable(`/Orders?filterByFormula=${encoded}`);

    if (!orderData.records || orderData.records.length === 0) {
      return {
        statusCode: 404,
        headers: { 'Content-Type': 'text/html' },
        body: errorPage('Link not found.', 'This download link is invalid or has expired. Email <a href="mailto:pinkpillrx@gmail.com">pinkpillrx@gmail.com</a> and we\'ll sort it out.')
      };
    }

    const order    = orderData.records[0];
    const recordId = order.id;
    const count    = order.fields['Download Count'] || 0;
    const productId = order.fields['Product ID'];

    // Check download limit
    if (count >= MAX_DOWNLOADS) {
      return {
        statusCode: 410,
        headers: { 'Content-Type': 'text/html' },
        body: errorPage(
          'Download limit reached.',
          `This link has been used ${MAX_DOWNLOADS} times. Email <a href="mailto:pinkpillrx@gmail.com">pinkpillrx@gmail.com</a> and we'll send you a fresh link right away.`
        )
      };
    }

    // Get current PDF URL from Airtable Products table
    // This is the key to making the PDF updatable — the URL lives in Airtable,
    // not in the code. Update it in Airtable whenever you upload a new version.
    let downloadFileUrl = null;

    if (productId) {
      const encoded2 = encodeURIComponent(`{Product ID}="${productId}"`);
      const productData = await airtable(`/Products?filterByFormula=${encoded2}`);
      if (productData.records && productData.records.length > 0) {
        downloadFileUrl = productData.records[0].fields['Download URL'];
      }
    }

    if (!downloadFileUrl) {
      return {
        statusCode: 500,
        headers: { 'Content-Type': 'text/html' },
        body: errorPage(
          'Download unavailable.',
          'Something went wrong on our end. Please email <a href="mailto:pinkpillrx@gmail.com">pinkpillrx@gmail.com</a> and we\'ll send the file directly.'
        )
      };
    }

    // Increment download count in Airtable (non-blocking — don't await fully)
    airtable(`/Orders/${recordId}`, 'PATCH', {
      fields: { 'Download Count': count + 1 }
    }).catch(err => console.error('Count update failed:', err));

    // Redirect to the current PDF URL
    return {
      statusCode: 302,
      headers: { Location: downloadFileUrl },
      body: ''
    };

  } catch (err) {
    console.error('Download function error:', err);
    return {
      statusCode: 500,
      headers: { 'Content-Type': 'text/html' },
      body: errorPage(
        'Something went wrong.',
        'Please try again or email <a href="mailto:pinkpillrx@gmail.com">pinkpillrx@gmail.com</a>.'
      )
    };
  }
};
